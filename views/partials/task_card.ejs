<div class="task-card" draggable="true" data-task-id="<%= task.id %>" onclick="if(!event.target.closest('button') && !event.target.closest('a')) window.location.href='/tasks/<%= task.id %>';">
  <div class="task-card-header">
    <span class="priority-badge priority-<%= task.priority %>">
      <%= task.priority.toUpperCase() %>
    </span>
    <span class="task-id">#<%= task.id %></span>
  </div>

  <h4 class="task-card-title">
    <a href="/tasks/<%= task.id %>"><%= task.title %></a>
  </h4>

  <% if (task.description) { %>
    <p class="task-card-desc">
      <%= task.description.length > 80 ? task.description.substring(0, 80) + '...' : task.description %>
    </p>
  <% } %>

  <div class="task-card-footer">
    <div class="task-meta">
      <% if (task.due_date) { %>
        <span class="due-date-badge" title="Due Date">
          <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <%= task.due_date %>
        </span>
      <% } %>

      <span class="comments-count" title="Comments">
        <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        <%= task.comment_count || 0 %>
      </span>
    </div>

    <div class="assignee-badge">
      <% if (task.assignee_name) { %>
        <div class="avatar-xs" style="background-color: <%= task.assignee_color || '#4f46e5' %>" title="Assigned to @<%= task.assignee_name %>">
          <%= task.assignee_name.charAt(0).toUpperCase() %>
        </div>
      <% } else { %>
        <div class="avatar-xs unassigned" title="Unassigned">?</div>
      <% } %>
    </div>
  </div>
</div>
