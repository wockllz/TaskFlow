<%- include('partials/header') %>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-logo">⚡</div>
      <h2>Welcome Back</h2>
      <p>Log in to manage your project tasks and boards</p>
    </div>

    <form action="/login" method="POST" class="auth-form">
      <div class="form-group">
        <label for="loginInput">Username or Email</label>
        <input 
          type="text" 
          id="loginInput" 
          name="loginInput" 
          placeholder="e.g. sarah@taskflow.dev or sarah_pm" 
          required 
          autofocus
        >
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          placeholder="••••••••" 
          required
        >
      </div>

      <button type="submit" class="btn btn-primary btn-block">Log In to TaskFlow</button>
    </form>

    <div class="demo-credentials">
      <span class="demo-title">🔑 Quick Demo Accounts:</span>
      <div class="demo-buttons">
        <button type="button" class="demo-btn" onclick="fillDemo('sarah@taskflow.dev', 'password123')">
          <strong>Sarah (PM)</strong><br><small>sarah@taskflow.dev</small>
        </button>
        <button type="button" class="demo-btn" onclick="fillDemo('alex@taskflow.dev', 'password123')">
          <strong>Alex (Dev)</strong><br><small>alex@taskflow.dev</small>
        </button>
      </div>
    </div>

    <div class="auth-footer">
      <p>Don't have an account? <a href="/register">Create an account</a></p>
    </div>
  </div>
</div>

<script>
  function fillDemo(email, pass) {
    document.getElementById('loginInput').value = email;
    document.getElementById('password').value = pass;
  }
</script>

<%- include('partials/footer') %>
